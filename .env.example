# === PostgreSQL ===
POSTGRES_DB=bienes_bic
POSTGRES_USER=bic
# Solo caracteres válidos en URL. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=cambiar_en_produccion

# === Flask ===
FLASK_DEBUG=0
# Obligatoria: firma las cookies de sesión y los tokens CSRF. Generar con: openssl rand -hex 32
SECRET_KEY=
# 1 (por defecto): la cookie de sesión solo viaja por HTTPS. Usar 0 solo en local por HTTP
SESSION_COOKIE_SECURE=1
# Prefijo de publicación (en garnocex: /digibic). Vacío si se sirve en la raíz
URL_PREFIX=

# === Archivos del NAS ===
# Ruta en el host (NAS) donde están los archivos BIC
# Se monta como /data/BIC dentro del contenedor (solo lectura)
# Ejemplos en UGREEN:
#   /volume1/BIC
#   /mnt/user-data/BIC
NAS_BIC_PATH=/volume1/BIC
